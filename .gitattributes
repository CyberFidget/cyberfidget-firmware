*.bin -diff

# Shell scripts run on Linux CI runners - force LF so a Windows checkin
# (core.autocrlf=true) can't store CRLF and break them with bash: $'\r'.
*.sh text eol=lf

# Generated asset headers are compared BYTE FOR BYTE against fresh compiler
# output by the pre-build staleness gate, and the compiler always emits LF.
# Without this, core.autocrlf=true rewrites them to CRLF at checkout and the
# gate reports drift on every Windows working copy even though the committed
# content is identical - which fails the build for a reason that has nothing
# to do with the assets.
lib/*/generated/*.h text eol=lf

# Same argument, one directory up: the page headers are generated by
# portal-companion and compared byte for byte by the device-surfaces drift
# workflow, so they must not be rewritten to CRLF at checkout either.
lib/WebPortalApp/portal_page.h text eol=lf
lib/WebPortalApp/companion_shell_gz.h text eol=lf

# The generators inline these files verbatim into those headers. Normalising
# on read (build_sdpack.mjs, sync_chrome.mjs) is what actually makes the output
# platform-independent; forcing LF at checkout is the second layer, so a
# working copy looks the same as the CI runner's.
portal-companion/src/** text eol=lf