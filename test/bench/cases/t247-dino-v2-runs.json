{
  "name": "T-247 A: the Dino Run 2 device module runs on hardware",
  "fw_min": "1.3.3",
  "fixtures": ["dino_v2.wasm"],
  "steps": [
    {"do": "reset"}, {"do": "wait_cli"}, {"do": "nav_to_menu"},
    {"do": "ferry", "path": "/apps/dino_v2.wasm", "fixture": "dino_v2.wasm"},
    {"do": "lapply_add", "id": "dino-v2", "name": "Dino Run 2", "category": "Games", "format": "wasm", "path": "/apps/dino_v2.wasm", "version": "2.0.0"},
    {"do": "launch", "id": "dino-v2"},
    {"do": "wait", "ms": 3000},
    {"do": "screencap", "save": "dino-running", "review": "human"},
    {"do": "btn", "index": 1, "action": "tap"},
    {"do": "wait", "ms": 400},
    {"do": "screencap", "save": "dino-jumping", "review": "human"},
    {"do": "assert_wasmstat", "frames_gt": 0, "error": "none", "timeout_s": 3.0},
    {"do": "launch", "id": "menu"},
    {"do": "lapply_remove", "id": "dino-v2"},
    {"do": "fdelete", "path": "/apps/dino_v2.wasm"}
  ]
}
