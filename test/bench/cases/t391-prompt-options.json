{
  "name": "Update prompt: Install now / Remind me later / Skip this version at a stand-in offer, checked by reading back the update settings",
  "reviewer_setup": "Build and install local_test (the upd and btn verbs are test-build only). Preconditions: no app changes waiting for this unit and no stored upd.avail (nothing writes it until the update session exists), so no start-up popup covers the menu. The stand-in offer (upd offer) lives in RAM only; every stored change comes from a button answer. The case first clears a skip left by an earlier run through Settings > Updates (row 6, Skip/Unskip), then answers Install now, Remind me later and Skip this version, checking the upd read-back after each: Install now and Remind me later store nothing, Skip stores upd.rej, the skipped version is not offered again, a newer version is offered again. It ends by unskipping through Settings > Updates again, so reruns start clean. Screens are saved with --out for the legibility review. Run python test/bench/cf_replay.py test/bench/cases/t391-prompt-options.json --port <PORT> --out <dir>. For the human check (H1), afterwards send upd offer 9.9.1 and leave the device at the prompt.",
  "steps": [
    {"do": "reset"},
    {"do": "wait_cli"},
    {"do": "command", "command": "upd allow-unsigned off", "contains": ["[cmd] upd.unsig_ok=0"]},
    {"do": "wait", "ms": 6000},
    {"do": "launch", "id": "menu"},
    {"do": "assert_menutree", "has": "Check for updates"},
    {"do": "assert_menutree", "has": "Updates"},

    {"do": "launch", "id": "Updates"},
    {"do": "wait", "ms": 600},
    {"do": "screencap", "save": "settings-top", "review": "human"},
    {"do": "btn", "index": 1, "action": "tap"},
    {"do": "btn", "index": 1, "action": "tap"},
    {"do": "wait", "ms": 1500},
    {"do": "screencap", "save": "settings-autoapply-row", "review": "human"},
    {"do": "btn", "index": 1, "action": "tap"},
    {"do": "btn", "index": 1, "action": "tap"},
    {"do": "btn", "index": 1, "action": "tap"},
    {"do": "wait", "ms": 600},
    {"do": "screencap", "save": "settings-skip-row", "review": "human"},
    {"do": "btn", "index": 5, "action": "tap"},
    {"do": "wait", "ms": 600},
    {"do": "btn", "index": 1, "action": "tap"},
    {"do": "btn", "index": 1, "action": "tap"},
    {"do": "btn", "index": 1, "action": "tap"},
    {"do": "wait", "ms": 600},
    {"do": "screencap", "save": "settings-bottom", "review": "human"},
    {"do": "launch", "id": "menu"},
    {"do": "command", "command": "upd", "matches": "^(?![\\s\\S]*upd\\.key=rej )[\\s\\S]*upd\\.done=[0-9]+"},

    {"do": "command", "command": "upd offer 9.9.1", "contains": ["[cmd] upd.offer=open version=9.9.1 source=cyberfidget.com"]},
    {"do": "wait", "ms": 800},
    {"do": "screencap", "save": "prompt-install-focus", "review": "human"},
    {"do": "btn", "index": 5, "action": "tap"},
    {"do": "wait", "ms": 800},
    {"do": "screencap", "save": "install-coming-soon", "review": "human"},
    {"do": "btn", "index": 5, "action": "tap"},
    {"do": "wait", "ms": 400},
    {"do": "command", "command": "upd", "matches": "^(?![\\s\\S]*upd\\.key=rej )[\\s\\S]*upd\\.done=[0-9]+"},

    {"do": "command", "command": "upd offer 9.9.1", "contains": ["[cmd] upd.offer=open version=9.9.1"]},
    {"do": "btn", "index": 1, "action": "tap"},
    {"do": "wait", "ms": 800},
    {"do": "screencap", "save": "prompt-later-focus", "review": "human"},
    {"do": "btn", "index": 5, "action": "tap"},
    {"do": "wait", "ms": 400},
    {"do": "command", "command": "upd", "matches": "^(?![\\s\\S]*upd\\.key=rej )[\\s\\S]*upd\\.done=[0-9]+"},

    {"do": "command", "command": "upd offer 9.9.1", "contains": ["[cmd] upd.offer=open version=9.9.1"]},
    {"do": "btn", "index": 1, "action": "tap"},
    {"do": "btn", "index": 1, "action": "tap"},
    {"do": "wait", "ms": 1500},
    {"do": "screencap", "save": "prompt-skip-focus", "review": "human"},
    {"do": "btn", "index": 5, "action": "tap"},
    {"do": "wait", "ms": 400},
    {"do": "command", "command": "upd", "contains": ["[cmd] upd.key=rej type=str value=9.9.1"]},
    {"do": "command", "command": "upd offer 9.9.1", "contains": ["[cmd] upd.offer=suppressed reason=skipped version=9.9.1"]},

    {"do": "command", "command": "upd offer 9.9.2", "contains": ["[cmd] upd.offer=open version=9.9.2"]},
    {"do": "btn", "index": 1, "action": "tap"},
    {"do": "btn", "index": 5, "action": "tap"},
    {"do": "wait", "ms": 400},
    {"do": "command", "command": "upd", "contains": ["[cmd] upd.key=rej type=str value=9.9.1"]},
    {"do": "wait", "ms": 600},
    {"do": "screencap", "save": "menu-bar-update-ready", "review": "human"},

    {"do": "launch", "id": "Updates"},
    {"do": "btn", "index": 1, "action": "tap"},
    {"do": "btn", "index": 1, "action": "tap"},
    {"do": "btn", "index": 1, "action": "tap"},
    {"do": "btn", "index": 1, "action": "tap"},
    {"do": "btn", "index": 1, "action": "tap"},
    {"do": "wait", "ms": 600},
    {"do": "screencap", "save": "settings-unskip-row", "review": "human"},
    {"do": "btn", "index": 5, "action": "tap"},
    {"do": "wait", "ms": 400},
    {"do": "launch", "id": "menu"},
    {"do": "command", "command": "upd", "matches": "^(?![\\s\\S]*upd\\.key=rej )[\\s\\S]*upd\\.done=[0-9]+"}
  ]
}
