{
  "name": "Update on the Fidget: two app slots, streamed-hash check, self-test and rollback, power cut mid-write",
  "reviewer_setup": "Two local_test builds of the same code that differ only in version: X (the build under test, flashed with pio run -e local_test -t upload) and Y (the same tree built with version.txt one patch higher). Serve both with test/bench/fixtures/ota-site (README there): set CF_OTA_RELEASES to a folder holding releases made by make_release.py - x (X, released 2026-09-24T12:00:00Z, id 3), y (Y, 2026-09-24T11:00:00Z, id 2), ybad (Y with --wrong-sha), yflip (Y with --flip-offset 200000), ystale (Y released 2026-09-24T10:00:00Z, id 1), ynew (Y released 2026-09-24T13:00:00Z, id 4, for the check-in offer), down (--status 503) - and run C:\\php\\php.exe -S 0.0.0.0:8297 router.php. Environment: CF_OTA_HOST=<host ip>:8297, CF_VER_X / CF_VER_Y = the exact versions the builds report, CF_BENCH_PORT_A = HIL-A's port, CF_BENCH_PORT_B = HIL-B's port (the power-cut part; run with the cyberfidget-hil venv python so the ppk steps can drive the PPK2, CF_PPK_PORT optional). Both units need saved WiFi (the update session joins it; that join after each update is also the proof the saved network survived). The flow part starts from a USB-flashed X, so its first update runs from a slot with no update history. It sets a stand-in link credential (cloud token) and a marker file to prove the link and the filesystem survive, and removes both at the end; it leaves upd.unsig_ok on. Run: python test/bench/cf_replay.py test/bench/cases/t250-ota-ab.json --out <dir> [--part flow|powercut].",
  "parts": [
    {
      "name": "flow",
      "port_env": "CF_BENCH_PORT_A",
      "steps": [
        {"do": "reset", "until": "[update] boot slot=", "expand_env": true, "contains": ["[boot] fw=${CF_VER_X} "]},
        {"do": "wait_cli"},
        {"do": "command", "command": "upd slot", "contains": ["[cmd] upd.slot="]},
        {"do": "command", "command": "upd seen-clear", "contains": ["[cmd] upd.seen_clear="]},
        {"do": "command", "command": "cloud token t250-bench-standin", "contains": ["[cmd] cloud.token=ok"]},
        {"do": "command", "command": "link status", "contains": ["link.status=linked:yes"]},
        {"do": "ferry", "path": "/assets/t250-marker.bin", "fixture": "stopwatch.wasm"},
        {"do": "command", "command": "fstat /assets/t250-marker.bin", "contains": ["fstat.ok=/assets/t250-marker.bin size=10784 crc=40fb4ef8"]},

        {"do": "command", "command": "upd allow-unsigned off", "contains": ["[cmd] upd.unsig_ok=0"]},
        {"do": "command", "command": "upd install ${CF_VER_Y}", "expand_env": true, "contains": ["[cmd] upd.install=refused reason=unsigned"]},
        {"do": "command", "command": "upd allow-unsigned on", "contains": ["[cmd] upd.unsig_ok=1"]},

        {"do": "command", "command": "cloud base http://${CF_OTA_HOST}/y", "expand_env": true, "contains": ["[cmd] cloud.base=ok"]},
        {"do": "command", "command": "upd fault version", "contains": ["[cmd] upd.fault=version"]},
        {"do": "command", "command": "upd install ${CF_VER_Y}", "expand_env": true, "until": "[update] result=did-not-finish expected=", "timeout_s": 180,
         "order": ["[update] session=start", "gate=ok", "[update] progress=50", "[update] install=ready", "[update] session=end result=installed", "[boot] fw=${CF_VER_Y} ", "state=pending", "[update] selftest=fail reason=version", "[update] rollback reason=version", "[boot] fw=${CF_VER_X} ", "[update] result=did-not-finish expected="]},
        {"do": "wait_cli"},
        {"do": "command", "command": "upd slot", "matches": "upd\\.slot=(\\S+) state=\\S+ boot=\\1 .* pend_img=0 unsig_ok=1"},
        {"do": "command", "command": "fstat /assets/t250-marker.bin", "contains": ["fstat.ok=/assets/t250-marker.bin size=10784 crc=40fb4ef8"]},
        {"do": "command", "command": "upd", "expand_env": true, "contains": ["[cmd] upd.key=fail_ver type=str value=${CF_VER_Y}"]},

        {"do": "command", "command": "cloud base http://${CF_OTA_HOST}/ybad", "expand_env": true, "contains": ["[cmd] cloud.base=ok"]},
        {"do": "command", "command": "upd install ${CF_VER_Y}", "expand_env": true, "until": "[update] result=did-not-finish reason=session", "timeout_s": 180,
         "order": ["gate=ok", "[update] install=hash", "[update] session=end result=hash", "[boot] fw=${CF_VER_X} ", "[update] result=did-not-finish reason=session"]},
        {"do": "wait_cli"},
        {"do": "command", "command": "upd slot", "matches": "upd\\.slot=(\\S+) state=\\S+ boot=\\1 .* pend_img=0"},

        {"do": "command", "command": "cloud base http://${CF_OTA_HOST}/yflip", "expand_env": true, "contains": ["[cmd] cloud.base=ok"]},
        {"do": "command", "command": "upd install ${CF_VER_Y}", "expand_env": true, "until": "[update] result=did-not-finish reason=session", "timeout_s": 180,
         "order": ["gate=ok", "[update] install=hash", "[boot] fw=${CF_VER_X} "]},
        {"do": "wait_cli"},
        {"do": "command", "command": "upd slot", "matches": "upd\\.slot=(\\S+) state=\\S+ boot=\\1 .* pend_img=0"},

        {"do": "command", "command": "cloud base http://${CF_OTA_HOST}/down", "expand_env": true, "contains": ["[cmd] cloud.base=ok"]},
        {"do": "command", "command": "upd install ${CF_VER_Y}", "expand_env": true, "until": "[update] result=did-not-finish reason=session", "timeout_s": 120,
         "order": ["[update] manifest host=site http=503", "[update] manifest host=github outcome=unavailable", "[update] session=end result=site-unavailable", "[boot] fw=${CF_VER_X} "]},
        {"do": "wait_cli"},

        {"do": "command", "command": "cloud base http://${CF_OTA_HOST}/y", "expand_env": true, "contains": ["[cmd] cloud.base=ok"]},
        {"do": "launch", "id": "menu"},
        {"do": "wait", "ms": 800},
        {"do": "command", "command": "upd offer ${CF_VER_Y}", "expand_env": true, "contains": ["[cmd] upd.offer=open version=${CF_VER_Y}"]},
        {"do": "wait", "ms": 800},
        {"do": "screencap", "save": "prompt-install", "review": "human"},
        {"do": "command", "command": "btn 5 tap", "expand_env": true, "until": "[update] result=updated version=${CF_VER_Y}", "timeout_s": 180,
         "order": ["[upd] prompt=firmware choice=install", "[upd] install=restarting version=${CF_VER_Y}", "[update] session=start wanted=${CF_VER_Y} watchdog=1", "[update] progress=50", "[update] install=ready", "[boot] fw=${CF_VER_Y} ", "state=pending", "[update] selftest=pass reason=ok", "[update] confirmed ms=", "[update] result=updated version=${CF_VER_Y}"]},
        {"do": "wait_cli"},
        {"do": "command", "command": "version", "expand_env": true, "contains": ["[cmd] version=${CF_VER_Y}"]},
        {"do": "command", "command": "upd slot", "matches": "upd\\.slot=(\\S+) state=valid boot=\\1 .* pend_img=0 unsig_ok=1"},
        {"do": "command", "command": "upd", "matches": "^(?![\\s\\S]*upd\\.key=fail_ver )[\\s\\S]*upd\\.done=[0-9]+"},
        {"do": "reset", "until": "[upd] boot-popup", "timeout_s": 25, "expand_env": true, "contains": ["[boot] fw=${CF_VER_Y} "],
         "matches": "^(?![\\s\\S]*did-not-finish)[\\s\\S]*$"},
        {"do": "wait_cli"},
        {"do": "command", "command": "upd", "contains": ["upd.key=base type=str", "type=u32 value=1790247600", "upd.key=unsig_ok"]},
        {"do": "command", "command": "link status", "contains": ["link.status=linked:yes"]},
        {"do": "command", "command": "fstat /assets/t250-marker.bin", "contains": ["fstat.ok=/assets/t250-marker.bin size=10784 crc=40fb4ef8"]},

        {"do": "command", "command": "cloud base http://${CF_OTA_HOST}/ystale", "expand_env": true, "contains": ["[cmd] cloud.base=ok"]},
        {"do": "command", "command": "upd install ${CF_VER_Y}", "expand_env": true, "until": "[update] result=did-not-finish reason=session", "timeout_s": 120,
         "order": ["gate=stale", "[update] session=end result=stale", "[boot] fw=${CF_VER_Y} "]},
        {"do": "wait_cli"},

        {"do": "command", "command": "cloud base http://${CF_OTA_HOST}/x", "expand_env": true, "contains": ["[cmd] cloud.base=ok"]},
        {"do": "command", "command": "upd fault crash", "contains": ["[cmd] upd.fault=crash"]},
        {"do": "command", "command": "upd install ${CF_VER_X}", "expand_env": true, "until": "[update] result=did-not-finish expected=", "timeout_s": 180,
         "order": ["[update] install=ready", "[boot] fw=${CF_VER_X} ", "state=pending", "[update] selftest fault=crash", "[boot] fw=${CF_VER_Y} ", "[update] result=did-not-finish expected=${CF_VER_X}"]},
        {"do": "wait_cli"},
        {"do": "command", "command": "upd slot", "matches": "upd\\.slot=(\\S+) state=valid boot=\\1 .* pend_img=0"},

        {"do": "command", "command": "upd fault hang", "contains": ["[cmd] upd.fault=hang"]},
        {"do": "command", "command": "upd install ${CF_VER_X}", "expand_env": true, "until": "[update] result=did-not-finish expected=", "timeout_s": 180,
         "order": ["[update] install=ready", "[boot] fw=${CF_VER_X} ", "[update] selftest fault=hang", "[boot] fw=${CF_VER_Y} ", "[update] result=did-not-finish expected=${CF_VER_X}"]},
        {"do": "wait_cli"},

        {"do": "command", "command": "upd fault hal-hang", "contains": ["[cmd] upd.fault=hal-hang"]},
        {"do": "command", "command": "upd install ${CF_VER_X}", "expand_env": true, "until": "[update] result=did-not-finish expected=", "timeout_s": 180,
         "order": ["[update] install=ready", "[update] session=end result=installed", "[boot] fw=${CF_VER_Y} ", "[update] result=did-not-finish expected=${CF_VER_X}"]},
        {"do": "wait_cli"},
        {"do": "command", "command": "upd slot", "matches": "upd\\.slot=(\\S+) state=valid boot=\\1 .* pend_img=0"},

        {"do": "command", "command": "upd fault loop-crash", "contains": ["[cmd] upd.fault=loop-crash"]},
        {"do": "command", "command": "upd install ${CF_VER_X}", "expand_env": true, "until": "[update] result=did-not-finish expected=", "timeout_s": 180,
         "order": ["[update] install=ready", "[boot] fw=${CF_VER_X} ", "state=pending", "[update] selftest=pass reason=ok", "[update] loop fault=crash", "[boot] fw=${CF_VER_Y} ", "[update] result=did-not-finish expected=${CF_VER_X}"]},
        {"do": "wait_cli"},
        {"do": "command", "command": "upd", "expand_env": true, "contains": ["[cmd] upd.key=fail_ver type=str value=${CF_VER_X}"]},

        {"do": "command", "command": "upd fault mount", "contains": ["[cmd] upd.fault=mount"]},
        {"do": "command", "command": "upd install ${CF_VER_X}", "expand_env": true, "until": "[update] result=did-not-finish expected=", "timeout_s": 180,
         "order": ["[update] install=ready", "[boot] fw=${CF_VER_X} ", "[update] selftest=fail reason=filesystem", "[update] rollback reason=filesystem", "[boot] fw=${CF_VER_Y} ", "[update] result=did-not-finish expected=${CF_VER_X}"]},
        {"do": "wait_cli"},
        {"do": "command", "command": "fstat /assets/t250-marker.bin", "contains": ["fstat.ok=/assets/t250-marker.bin size=10784 crc=40fb4ef8"]},

        {"do": "command", "command": "upd fault session-hang", "contains": ["[cmd] upd.fault=session-hang"]},
        {"do": "command", "command": "upd install ${CF_VER_X}", "expand_env": true, "until": "[update] result=did-not-finish reason=session", "timeout_s": 180,
         "order": ["[update] session=start", "[update] session fault=hang", "[boot] fw=${CF_VER_Y} ", "[update] result=did-not-finish reason=session"]},
        {"do": "wait_cli"},
        {"do": "command", "command": "upd slot", "matches": "upd\\.slot=(\\S+) state=valid boot=\\1 .* pend_img=0"},

        {"do": "command", "command": "upd install ${CF_VER_X}", "expand_env": true, "until": "[update] result=updated version=${CF_VER_X}", "timeout_s": 180,
         "order": ["[update] install=ready", "[boot] fw=${CF_VER_X} ", "state=pending", "[update] selftest=pass reason=ok", "[update] confirmed ms=", "[update] result=updated version=${CF_VER_X}"]},
        {"do": "wait_cli"},
        {"do": "command", "command": "version", "expand_env": true, "contains": ["[cmd] version=${CF_VER_X}"]},
        {"do": "command", "command": "upd slot", "matches": "upd\\.slot=(\\S+) state=valid boot=\\1 .* pend_img=0 unsig_ok=1"},
        {"do": "command", "command": "upd", "matches": "^(?![\\s\\S]*upd\\.key=fail_ver )[\\s\\S]*upd\\.done=[0-9]+"},
        {"do": "command", "command": "upd", "contains": ["upd.key=base type=str", "type=u32 value=1790251200", "upd.key=unsig_ok"]},
        {"do": "command", "command": "link status", "contains": ["link.status=linked:yes"]},
        {"do": "command", "command": "fstat /assets/t250-marker.bin", "contains": ["fstat.ok=/assets/t250-marker.bin size=10784 crc=40fb4ef8"]},

        {"do": "command", "command": "cloud base http://${CF_OTA_HOST}/ynew", "expand_env": true, "contains": ["[cmd] cloud.base=ok"]},
        {"do": "reset", "until": "[checkin] reason=boot join_ms=", "timeout_s": 40, "expand_env": true,
         "order": ["[boot] fw=${CF_VER_X} ", "[update] manifest version=${CF_VER_Y} ", "gate=ok", "[update] offer=stored version=${CF_VER_Y} gate=ok write=ok", "[checkin] reason=boot join_ms="]},
        {"do": "wait_cli"},
        {"do": "command", "command": "upd", "expand_env": true, "contains": ["[cmd] upd.key=avail type=str value=${CF_VER_Y}"]},
        {"do": "command", "command": "cloud base http://${CF_OTA_HOST}/y", "expand_env": true, "contains": ["[cmd] cloud.base=ok"]},
        {"do": "command", "command": "cloud check", "until": "[cmd] cloud.result=", "timeout_s": 60,
         "order": ["gate=stale", "[update] offer=withdrawn", "[cmd] cloud.result="]},
        {"do": "command", "command": "upd", "matches": "^(?![\\s\\S]*upd\\.key=avail )[\\s\\S]*upd\\.done=[0-9]+"},

        {"do": "fdelete", "path": "/assets/t250-marker.bin"},
        {"do": "command", "command": "link forget", "contains": ["[cmd] link.forget=ok"]},
        {"do": "command", "command": "upd fault none", "contains": ["[cmd] upd.fault=none"]}
      ]
    },
    {
      "name": "powercut",
      "port_env": "CF_BENCH_PORT_B",
      "steps": [
        {"do": "ppk", "action": "on", "voltage": 3.7},
        {"do": "reset", "until": "[update] boot slot=", "expand_env": true, "contains": ["[boot] fw=${CF_VER_X} "]},
        {"do": "wait_cli"},
        {"do": "command", "command": "upd allow-unsigned on", "contains": ["[cmd] upd.unsig_ok=1"]},
        {"do": "command", "command": "cloud base http://${CF_OTA_HOST}/y", "expand_env": true, "contains": ["[cmd] cloud.base=ok"]},
        {"do": "command", "command": "upd slot", "matches": "upd\\.slot=(\\S+) state=\\S+ boot=\\1 "},
        {"do": "command", "command": "upd install ${CF_VER_Y}", "expand_env": true, "until": "[update] progress=30", "timeout_s": 120,
         "order": ["[update] session=start", "gate=ok", "[update] slot=", "[update] progress=30"]},
        {"do": "ppk", "action": "off"},
        {"do": "wait", "ms": 3000},
        {"do": "ppk", "action": "on", "voltage": 3.7, "until": "[update] boot slot=", "timeout_s": 25, "expand_env": true,
         "contains": ["[boot] fw=${CF_VER_X} "]},
        {"do": "wait_cli"},
        {"do": "command", "command": "version", "expand_env": true, "contains": ["[cmd] version=${CF_VER_X}"]},
        {"do": "command", "command": "upd slot", "matches": "upd\\.slot=(\\S+) state=\\S+ boot=\\1 .* pend_img=0 unsig_ok=1"},
        {"do": "command", "command": "upd", "contains": ["upd.key=base type=str value=http://"]},
        {"do": "command", "command": "upd install ${CF_VER_Y}", "expand_env": true, "until": "[update] manifest version=", "timeout_s": 60,
         "contains": ["[update] joined ms="]},
        {"do": "ppk", "action": "off"}
      ]
    }
  ]
}
