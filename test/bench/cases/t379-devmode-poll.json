          ]
        },
        {
          "do": "command",
          "command": "app",
          "contains": [
            "app.name=menu"
          ]
        },
        {
          "do": "command",
          "command": "awake",
          "contains": [
            "worker=1"
          ]
        },
        {
          "do": "command",
          "command": "launch Music Player",
          "contains": [
            "[awake] bluetooth=ask app=music"
          ]
        },
        {
          "do": "wait",
          "ms": 600
        },
        {
          "do": "command",
          "command": "btn 5 tap",
