          "ms": 600
        },
        {
          "do": "screencap",
          "save": "bluetooth-prompt",
          "review": "human"
        },
        {
          "do": "btn",
          "index": 1,
          "action": "tap"
        },
        {
          "do": "command",
          "command": "btn 5 tap",
          "timeout_s": 1.5,
          "contains": [
