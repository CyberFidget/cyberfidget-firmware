            "radio_used=1",
            "[boot] fw=",
            "[wasm] reopen=boot id=",
            "found=1"
          ]
        },
        {
          "do": "wait_cli"
        },
        {
          "do": "wait",
          "ms": 2500
        },
        {
          "do": "assert_wasmstat",
          "frames_gt": 0,
          "error": "none",
          "timeout_s": 3.0
        },
        {
