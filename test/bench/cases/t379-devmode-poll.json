        },
        {
          "do": "reset"
        },
        {
          "do": "wait_cli"
        },
        {
          "do": "wait",
          "ms": 6000,
          "why": "let the start-up check-in finish (cloud base is refused while a session runs)"
        },
        {
          "do": "command",
          "command": "cloud base $CF_BENCH_BASE",
          "expand_env": true,
          "contains": [
            "[cmd] cloud.base=ok"
          ]
        },
        {
          "do": "command",
          "command": "cloud token $CF_BENCH_TOKEN",
