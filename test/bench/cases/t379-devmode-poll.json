            "[cmd] cloud.token=ok"
          ]
        },
        {
          "do": "command",
          "command": "awake crash 3",
          "contains": [
            "[cmd] awake.crash=3"
          ]
        },
        {
          "do": "command",
          "command": "awake set dev until",
          "until": "[awake] boot mode=off",
          "timeout_s": 90,
          "order": [
            "[awake] boot mode=dev",
            "[awake] listen=start",
            "[awake] test-crash left=2",
            "abort()",
            "[awake] abnormal-reset count=1",
            "[awake] test-crash left=1",
            "[awake] abnormal-reset count=2",
            "[awake] test-crash left=0",
            "[awake] abnormal-reset count=3",
            "[awake] end=restart-loop mode=dev write=ok",
            "[awake] boot mode=off stop=idle listen=0 bt_released=0"
          ]
        },
        {
          "do": "wait_cli"
        },
        {
