          "frames_gt": 0,
          "error": "none",
          "timeout_s": 3.0
        },
        {
          "do": "launch",
          "id": "menu"
        },
        {
          "do": "command",
          "command": "cloud bootcheck on",
          "contains": [
            "[cmd] cloud.bootcheck=on"
          ]
        }
