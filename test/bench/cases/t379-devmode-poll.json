            "wifi=off",
            "[boot] fw=",
            "[awake] boot mode=dev stop=until listen=0 bt_released=0"
          ]
        },
        {
          "do": "wait_cli"
        },
        {
          "do": "command",
          "command": "app",
          "contains": [
            "app.name=Music Player"
          ]
        },
        {
          "do": "command",
          "command": "awake",
          "contains": [
            "awake.mode=dev stop=until listen=0 worker=0",
            "bt_restart=0"
          ]
        },
        {
          "do": "reset",
          "until": "[dev] poll=1 ",
          "timeout_s": 30,
          "contains": [
            "[awake] boot mode=dev stop=until listen=1 bt_released=1"
          ]
        },
        {
          "do": "wait_cli"
        },
        {
          "do": "command",
          "command": "awake set off",
          "until": "[awake] boot mode=off",
          "timeout_s": 15
        }
      ]
    },
    {
      "name": "reopen",
      "steps": [
