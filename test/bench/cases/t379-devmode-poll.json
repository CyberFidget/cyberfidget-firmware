            "wifi=off",
            "[boot] fw=",
            "[awake] boot mode=off stop=idle listen=0 bt_released=0",
            "ended=idle"
          ]
        },
        {
          "do": "wait_cli"
        },
        {
          "do": "screencap",
          "save": "after-idle-end",
          "review": "human"
        },
        {
          "do": "command",
          "command": "awake set dev until",
          "until": "[dev] poll=1 ",
          "timeout_s": 30
        },
        {
          "do": "wait_cli"
        },
        {
          "do": "command",
          "command": "awake battery low",
          "contains": [
            "[cmd] awake.battery=low"
          ]
        },
        {
          "do": "watch",
          "until": "[awake] boot mode=off",
          "timeout_s": 90,
          "order": [
            "[awake] end=battery mode=dev",
            "wifi=off",
            "[boot] fw=",
            "ended=battery"
          ]
        },
        {
          "do": "wait_cli"
        },
        {
          "do": "command",
          "command": "awake set stay until",
          "contains": [
            "[awake] set mode=stay stop=until effect=save"
          ]
        },
        {
          "do": "command",
          "command": "awake safety 10",
          "contains": [
            "[cmd] awake.safety_ms=10000"
          ]
        },
        {
          "do": "watch",
          "until": "[awake] end=safety-net mode=stay",
          "timeout_s": 20
        },
        {
          "do": "command",
          "command": "awake",
          "contains": [
            "awake.mode=off"
          ]
        },
        {
          "do": "command",
          "command": "awake safety 0",
          "contains": [
            "awake.safety_ms=172800000"
          ]
        },
        {
          "do": "command",
          "command": "awake set dev until",
          "until": "[dev] poll=1 ",
          "timeout_s": 30
        },
        {
          "do": "wait_cli"
        },
        {
          "do": "command",
          "command": "awake set off",
          "until": "[awake] boot mode=off",
          "timeout_s": 15,
          "order": [
            "[awake] set mode=off stop=idle effect=restart",
            "wifi=off",
            "[boot] fw=",
            "[awake] boot mode=off stop=idle listen=0 bt_released=0"
          ]
        }
      ]
    },
    {
      "name": "latch",
      "steps": [
        {
          "do": "reset"
        },
        {
          "do": "wait_cli"
        },
        {
          "do": "command",
          "command": "awake set off",
          "timeout_s": 4
        },
        {
          "do": "reset"
        },
        {
          "do": "wait_cli"
        },
        {
          "do": "command",
          "command": "awake legacy 2",
          "contains": [
            "[cmd] awake.legacy=2"
          ]
        },
        {
          "do": "reset",
          "until": "[awake] boot",
          "timeout_s": 25,
          "order": [
            "[awake] migrated legacy=2 mode=dev stop=until write=ok",
            "[awake] boot mode=dev stop=until listen=1 bt_released=1"
          ]
        },
        {
          "do": "wait_cli"
        },
        {
          "do": "command",
          "command": "upd",
          "matches": "upd\\.key=dev type=u8 value=2[\\s\\S]*upd\\.key=awake type=u8 value=2|upd\\.key=awake type=u8 value=2[\\s\\S]*upd\\.key=dev type=u8 value=2"
        },
        {
          "do": "reset",
          "until": "[awake] boot",
          "timeout_s": 25,
          "contains": [
            "[awake] boot mode=dev stop=until listen=1"
          ]
        },
        {
          "do": "wait_cli"
        },
        {
          "do": "command",
          "command": "awake set stay idle",
          "until": "[awake] boot mode=stay",
          "timeout_s": 15
        },
        {
          "do": "wait_cli"
        },
        {
          "do": "reset",
          "until": "[awake] boot",
          "timeout_s": 25,
          "contains": [
            "[awake] boot mode=stay stop=idle listen=0 bt_released=0"
          ]
        },
        {
          "do": "wait_cli"
        },
        {
          "do": "wait",
          "ms": 70000
        },
        {
          "do": "command",
          "command": "app",
          "contains": [
            "[cmd] app.index="
          ]
        },
        {
          "do": "command",
          "command": "awake set off",
          "contains": [
            "effect=save"
          ]
        }
      ]
    },
    {
      "name": "bluetooth",
      "steps": [
        {
          "do": "reset"
        },
        {
          "do": "wait_cli"
        },
        {
          "do": "command",
          "command": "awake set off",
          "timeout_s": 4
        },
        {
          "do": "reset"
        },
        {
          "do": "wait_cli"
        },
        {
          "do": "command",
          "command": "awake set dev until",
          "until": "[dev] poll=1 ",
          "timeout_s": 30
        },
        {
          "do": "wait_cli"
        },
        {
