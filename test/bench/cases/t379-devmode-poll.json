          "do": "reset"
        },
        {
          "do": "wait_cli"
        },
        {
          "do": "command",
          "command": "awake set off",
          "timeout_s": 4
        },
        {
          "do": "command",
          "command": "cloud bootcheck on",
          "contains": [
            "[cmd] cloud.bootcheck=on"
          ]
        },
        {
          "do": "reset",
          "until": "[checkin] boot-result=",
          "timeout_s": 30,
          "matches": "\\[checkin\\] reason=boot join_ms=[1-9]"
        },
        {
          "do": "wait_cli"
        },
        {
          "do": "launch",
          "id": "menu"
        },
        {
          "do": "command",
          "command": "launch $CF_DEV_APP_ID",
