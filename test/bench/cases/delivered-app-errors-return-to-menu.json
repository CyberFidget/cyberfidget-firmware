{
  "name": "Every delivered-app error screen returns to the menu on a button press (no app staged, file missing, ABI refused, malformed module), and the menu shows no blank row",
  "fw_min": "1.3.3",
  "fixtures": ["bad.wasm", "stopwatch.wasm"],
  "reviewer_setup": "A local_test build. Index 46 is the delivered-app host slot (check with `apps`); launching it directly is what the blank menu row did after Reset to factory. Each error screen must leave on a tap of a NON-Back button (index 2) and of Back (index 4); `app` must then report the menu. Screencaps: 'App failed to load' / reason / 'press any button', or 'App needs newer firmware', or '<name> / stopped with an error'.",
  "steps": [
    {"do": "reset"}, {"do": "wait_cli"}, {"do": "nav_to_menu"},
    {"do": "assert_menutree", "not_has": "label= blob="},

    {"_comment": "1 - nothing staged (the blank row's path)",
     "do": "command", "command": "launch 46", "contains": ["launch.ok=46"]},
    {"do": "wait", "ms": 800},
    {"do": "screencap", "save": "no-app-staged", "review": "human"},
    {"do": "assert_wasmstat", "error": "no app staged"},
    {"do": "btn", "index": 2, "action": "tap"},
    {"do": "wait", "ms": 600},
    {"do": "command", "command": "app", "contains": ["app.name=menu"]},

    {"_comment": "2 - the manifest points at a file that is not there",
     "do": "lapply_add", "id": "gone-app", "name": "Gone App", "category": "Tools", "format": "wasm", "path": "/apps/gone.wasm", "version": "1.0.0", "abi": "1"},
    {"do": "launch", "id": "gone-app"},
    {"do": "wait", "ms": 800},
    {"do": "screencap", "save": "file-missing", "review": "human"},
    {"do": "assert_wasmstat", "error": "missing: /apps/gone.wasm"},
    {"do": "btn", "index": 4, "action": "tap"},
    {"do": "wait", "ms": 600},
    {"do": "command", "command": "app", "contains": ["app.name=menu"]},
    {"do": "lapply_remove", "id": "gone-app"},

    {"_comment": "3 - needs a newer firmware (refused before loading)",
     "do": "ferry", "path": "/apps/stopwatch.wasm", "fixture": "stopwatch.wasm"},
    {"do": "lapply_add", "id": "abi-future", "name": "FutureApp", "category": "Tools", "format": "wasm", "path": "/apps/stopwatch.wasm", "version": "1.0.0", "abi": "99"},
    {"do": "launch", "id": "abi-future", "expect_error": "abi_unsupported"},
    {"do": "wait", "ms": 800},
    {"do": "screencap", "save": "abi-refused", "review": "human"},
    {"do": "assert_wasmstat", "error": "abi_unsupported"},
    {"do": "btn", "index": 2, "action": "tap"},
    {"do": "wait", "ms": 600},
    {"do": "command", "command": "app", "contains": ["app.name=menu"]},
    {"do": "lapply_remove", "id": "abi-future"},
    {"do": "fdelete", "path": "/apps/stopwatch.wasm"},

    {"_comment": "4 - a malformed module (the running app's own error screen)",
     "do": "ferry", "path": "/apps/bad.wasm", "fixture": "bad.wasm"},
    {"do": "lapply_add", "id": "bad-wasm", "name": "Bad WASM", "category": "Games", "format": "wasm", "path": "/apps/bad.wasm", "version": "1.0.0", "abi": "1"},
    {"do": "launch", "id": "bad-wasm"},
    {"do": "wait", "ms": 1500},
    {"do": "screencap", "save": "malformed", "review": "human"},
    {"do": "assert_wasmstat", "error": "malformed Wasm binary"},
    {"do": "btn", "index": 2, "action": "tap"},
    {"do": "wait", "ms": 600},
    {"do": "command", "command": "app", "contains": ["app.name=menu"]},
    {"do": "lapply_remove", "id": "bad-wasm"},
    {"do": "fdelete", "path": "/apps/bad.wasm"}
  ]
}
