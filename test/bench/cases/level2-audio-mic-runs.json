{
  "name": "A level-2 app plays a held note and enables the mic without error; leaving it silences the note",
  "fw_min": "1.4.2",
  "fixtures": [
    "audio_levels.wasm"
  ],
  "steps": [
    {
      "do": "reset"
    },
    {
      "do": "wait_cli"
    },
    {
      "_comment": "Mic state is not observable over the CLI: the mic diagnostic (MicCapture) parks AudioManager's metering by design, so it cannot be used to check an app's mic. The app's mic calls use the same AudioManager metering as the built-in Booper and Dancing Gnomes.",
      "do": "wait",
      "ms": 0
    },
    {
      "do": "nav_to_menu"
    },
    {
      "do": "ferry",
      "path": "/apps/audio_levels.wasm",
      "fixture": "audio_levels.wasm"
    },
    {
      "do": "lapply_add",
      "id": "level2-audio",
      "name": "Level2Audio",
      "category": "Tools",
      "format": "wasm",
      "path": "/apps/audio_levels.wasm",
      "version": "1.0.0",
      "abi": "2"
    },
    {
      "do": "reset"
    },
    {
      "do": "wait_cli"
    },
    {
      "do": "nav_to_menu"
    },
    {
      "_comment": "the app plays a held 440 Hz note and enables the mic in app_begin, and never stops either",
      "do": "launch",
      "id": "level2-audio"
    },
    {
      "do": "wait",
      "ms": 800
    },
    {
      "do": "assert_wasmstat",
      "error": "none",
      "timeout_s": 2
    },
    {
      "do": "command",
      "command": "abench stats reset",
      "contains": [
        "stats.reset"
      ]
    },
    {
      "do": "wait",
      "ms": 300
    },
    {
      "_comment": "a voice is sounding: the held note",
      "do": "command",
      "command": "abench stats",
      "matches": "peak_voices=[1-9]"
    },
    {
      "_comment": "leaving the app: the host stops its notes and turns off the mic it enabled",
      "do": "launch",
      "id": "menu"
    },
    {
      "do": "wait",
      "ms": 800
    },
    {
      "do": "command",
      "command": "abench stats reset",
      "contains": [
        "stats.reset"
      ]
    },
    {
      "do": "wait",
      "ms": 300
    },
    {
      "do": "command",
      "command": "abench stats",
      "contains": [
        "peak_voices=0 "
      ]
    },
    {
      "do": "lapply_remove",
      "id": "level2-audio"
    },
    {
      "do": "fdelete",
      "path": "/apps/audio_levels.wasm"
    }
  ]
}
